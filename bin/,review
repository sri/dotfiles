#!/usr/bin/env bash

# Usage: ,review [PR_URL]
# With no URL, reads the PR URL from the clipboard. This may be run from any
# directory, but the PR's base repo must be checked out under ~/ws, ~/dev, or ~/my.
set -euo pipefail

case $# in
  0) PR_URL="$(pbpaste)" ;;
  1) PR_URL="$1" ;;
  *)
    echo "usage: ,review [pr-url]" >&2
    exit 2
    ;;
esac

if [[ ! "$PR_URL" =~ ^https?://[^[:space:]]+$ ]]; then
  echo "error: expected an HTTP(S) pull request URL" >&2
  exit 2
fi

# Get all PR metadata in one call. The repository in the URL is the base
# repository; the head repository may be a fork with a different name.
IFS=$'\t' read -r PR_NUMBER HEAD_REF HEAD_OWNER HEAD_REPO BASE_REPO_NAME < <(
  gh pr view "$PR_URL" \
    --json number,url,headRefName,headRepositoryOwner,headRepository \
    --jq '[.number, .headRefName, .headRepositoryOwner.login, .headRepository.name, (.url | split("/") | .[-3])] | @tsv'
)

# Prefer a matching current checkout, then search one level below the usual
# workspace directories. Herdr needs the checkout path, not just owner/repo.
REPO_SEARCH_DIRS=("$HOME/ws" "$HOME/dev" "$HOME/my")
REPO_DIR=""
if current_root="$(git -C "$PWD" rev-parse --show-toplevel 2>/dev/null)" &&
   [[ "$(basename "$current_root")" == "$BASE_REPO_NAME" ]]; then
  REPO_DIR="$current_root"
else
  for parent in "${REPO_SEARCH_DIRS[@]}"; do
    candidate="$parent/$BASE_REPO_NAME"
    [[ -d "$candidate" ]] || continue
    if candidate_root="$(git -C "$candidate" rev-parse --show-toplevel 2>/dev/null)" &&
       [[ "$(basename "$candidate_root")" == "$BASE_REPO_NAME" ]]; then
      REPO_DIR="$candidate_root"
      break
    fi
  done
fi

if [[ -z "$REPO_DIR" ]]; then
  {
    echo "error: could not find a Git checkout named '$BASE_REPO_NAME'"
    printf 'searched the current worktree'
    for parent in "${REPO_SEARCH_DIRS[@]}"; do
      printf ", '%s/%s'" "$parent" "$BASE_REPO_NAME"
    done
    printf '\n'
  } >&2
  exit 1
fi

review_prompt="Review pull request $PR_URL.

Read the repository's CLAUDE.md and any relevant project instructions
first. Run git pull --ff-only before starting the review so the branch
is up to date.

Review the PR against its base branch. Focus on:
- correctness and bugs
- regressions
- edge cases
- security issues
- concurrency/data consistency issues
- missing or inadequate tests
- unnecessary complexity

Do not modify files. Produce a concise review with findings ordered by
severity. For each finding, include the file and line/range when
possible. Do not post anything to the PR after you are done. I want to
raed your comments first."

# State 3: the review workspace and its waiting agent already exist. Re-prompt it.
worktree_list="$(herdr worktree list --cwd "$REPO_DIR" --json)"
existing_workspace="$(
  jq -r --arg branch "$HEAD_REF" \
    '[.result.worktrees[] | select(.branch == $branch and .open_workspace_id)][0].open_workspace_id // empty' \
    <<<"$worktree_list"
)"
existing_worktree_path="$(
  jq -r --arg branch "$HEAD_REF" \
    '[.result.worktrees[] | select(.branch == $branch)][0].path // empty' \
    <<<"$worktree_list"
)"
if [[ -n "$existing_workspace" ]]; then
  existing_agent="$(
    herdr agent list |
      jq -r --arg workspace "$existing_workspace" \
        '[.result.agents[] | select(.workspace_id == $workspace)][0].pane_id // empty'
  )"
  if [[ -z "$existing_agent" ]]; then
    echo "error: review workspace exists but has no agent" >&2
    exit 1
  fi
  herdr agent prompt "$existing_agent" "$review_prompt"
  exit 0
fi

# Fetch the author's latest branch.
PR_HOST="${PR_URL#*://}"
PR_HOST="${PR_HOST%%/*}"
REMOTE="pr-${PR_NUMBER}"
REMOTE_URL="https://${PR_HOST}/${HEAD_OWNER}/${HEAD_REPO}.git"
if git -C "$REPO_DIR" remote get-url "$REMOTE" >/dev/null 2>&1; then
  git -C "$REPO_DIR" remote set-url "$REMOTE" "$REMOTE_URL"
else
  git -C "$REPO_DIR" remote add "$REMOTE" "$REMOTE_URL"
fi
git -C "$REPO_DIR" fetch "$REMOTE" "$HEAD_REF"
UPSTREAM="${REMOTE}/${HEAD_REF}"

if [[ -n "$existing_worktree_path" ]]; then
  # State 2: the worktree remains on disk after its workspace was closed.
  # Reopen it rather than trying to force-update its checked-out branch.
  git -C "$existing_worktree_path" branch --set-upstream-to="$UPSTREAM" "$HEAD_REF"
  created="$(
    herdr worktree open \
      --cwd "$REPO_DIR" \
      --path "$existing_worktree_path" \
      --label "PR #${PR_NUMBER}" \
      --no-focus \
      --json
  )"
else
  # State 1: create a new branch, worktree, and background workspace.
  git -C "$REPO_DIR" branch -f "$HEAD_REF" "$UPSTREAM"
  git -C "$REPO_DIR" branch --set-upstream-to="$UPSTREAM" "$HEAD_REF"
  created="$(
    herdr worktree create \
      --cwd "$REPO_DIR" \
      --branch "$HEAD_REF" \
      --base "$UPSTREAM" \
      --label "PR #${PR_NUMBER}" \
      --no-focus \
      --json
  )"
fi
pane_id="$(jq -r '.result.root_pane.pane_id' <<<"$created")"
agent_name="pr${PR_NUMBER}"

# Use the first available supported review agent.
possible_agents=(claude grok pi)
agent_kind=""
for candidate in "${possible_agents[@]}"; do
  if command -v "$candidate" >/dev/null 2>&1; then
    agent_kind="$candidate"
    break
  fi
done
if [[ -z "$agent_kind" ]]; then
  echo "error: install one of: ${possible_agents[*]}" >&2
  exit 1
fi

# A newly opened workspace can be returned just before its shell is ready.
# Retry only that transient condition; surface every other error immediately.
for attempt in {1..20}; do
  if start_output="$(
    herdr agent start "$agent_name" \
      --kind "$agent_kind" \
      --pane "$pane_id" 2>&1
  )"; then
    [[ -n "$start_output" ]] && printf '%s\n' "$start_output"
    break
  fi

  if [[ "$start_output" != *'"code":"agent_pane_busy"'* ]] || (( attempt == 20 )); then
    printf '%s\n' "$start_output" >&2
    exit 1
  fi
  sleep 0.25
done

herdr agent prompt "$agent_name" "$review_prompt"
