#!/usr/bin/env bash
set -uo pipefail

root_dir="${1:-$PWD}"

if [[ ! -d "$root_dir" ]]; then
  echo "Error: not a directory: $root_dir" >&2
  exit 1
fi

shopt -s nullglob

repo_count=0
failure_count=0

pull_with_retry() {
  local dir="$1"
  local repo_name="$2"
  local stash_name

  if git -C "$dir" pull; then
    return 0
  fi

  stash_name="auto-stash before git pull on $(date '+%Y-%m-%d %H:%M:%S')"
  echo "Pull failed in $repo_name; stashing local changes and retrying..."

  if ! git -C "$dir" stash push --include-untracked -m "$stash_name"; then
    echo "Failed to stash changes in $repo_name" >&2
    return 1
  fi

  git -C "$dir" pull
}

for dir in "$root_dir"/*/; do
  [[ -d "$dir" ]] || continue

  if [[ -d "$dir/.git" || -f "$dir/.git" ]]; then
    repo_count=$((repo_count + 1))
    repo_name="$(basename "$dir")"

    echo
    echo "==> $repo_name"

    if ! pull_with_retry "$dir" "$repo_name"; then
      failure_count=$((failure_count + 1))
      echo "Failed: $repo_name" >&2
    fi
  fi
done

if [[ "$repo_count" -eq 0 ]]; then
  echo "No git repos found under $root_dir"
  exit 0
fi

echo
echo "Processed $repo_count repo(s)"

if [[ "$failure_count" -gt 0 ]]; then
  echo "Failures: $failure_count" >&2
  exit 1
fi
