#!/usr/bin/env bash

set -euo pipefail

if [[ -z "${EMACS_DIR+x}" ]]; then
  EMACS_DIR="/Applications/Emacs.app/Contents/MacOS/bin"
fi
EMACS="${EMACS_DIR}/emacs"
EMACSCLIENT="${EMACS_DIR}/emacsclient"
SKIP_FILE="$HOME/.emacs.skip"

EMACS_ARGS=()
CLIENT_ARGS=()
POSITIONAL_ARGS=()
SKIP=false
NEW=false
GUI=false
MAGIT=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    -new)
      NEW=true
      ;;
    -gui)
      GUI=true
      ;;
    -nw)
      # Kept as a backwards-compatible alias for the default behavior.
      GUI=false
      ;;
    -skip)
      SKIP=true
      ;;
    --magit)
      MAGIT=true
      ;;
    -q)
      # -Q is only meaningful when starting a new Emacs process.
      EMACS_ARGS+=(
        "-Q"
        "--eval"
        "(progn (require 'package) (package-initialize))"
      )
      ;;
    *)
      POSITIONAL_ARGS+=("$1")
      ;;
  esac
  shift
done

absolute_existing_path() {
  local path=$1
  if [[ -e "$path" && "$path" != /* ]]; then
    printf '%s/%s\n' "$PWD" "$path"
  else
    printf '%s\n' "$path"
  fi
}

if $MAGIT; then
  if (( ${#POSITIONAL_ARGS[@]} > 1 )); then
    printf 'usage: ,em [directory]\n' >&2
    exit 2
  fi

  MAGIT_DIR=${POSITIONAL_ARGS[0]:-$PWD}
  if [[ ! -d "$MAGIT_DIR" ]]; then
    printf ',em: not a directory: %s\n' "$MAGIT_DIR" >&2
    exit 1
  fi
  MAGIT_DIR=$(absolute_existing_path "$MAGIT_DIR")

  # Quote the directory as an Emacs Lisp string.
  MAGIT_DIR=${MAGIT_DIR//\\/\\\\}
  MAGIT_DIR=${MAGIT_DIR//\"/\\\"}
  MAGIT_EVAL="(progn (require 'magit) (magit-status \"${MAGIT_DIR}\"))"
  EMACS_ARGS+=("--eval" "$MAGIT_EVAL")
  CLIENT_ARGS+=("--eval" "$MAGIT_EVAL")
else
  for arg in ${POSITIONAL_ARGS[@]+"${POSITIONAL_ARGS[@]}"}; do
    # emacsclient resolves relative paths from the server's working directory,
    # which may differ from this shell. Existing files and directories must be
    # made absolute so files open correctly and directories open in Dired.
    arg=$(absolute_existing_path "$arg")
    EMACS_ARGS+=("$arg")
    CLIENT_ARGS+=("$arg")
  done
fi

if $SKIP; then
  touch "$SKIP_FILE"
else
  rm -f "$SKIP_FILE"
fi

emacs_is_running() {
  pgrep -x Emacs >/dev/null 2>&1 || pgrep -x emacs >/dev/null 2>&1
}

# Start a new Emacs when requested or when no instance exists. New instances
# are terminal-only by default; -gui is the only way to start one in GUI mode.
if $NEW || ! emacs_is_running; then
  if $GUI; then
    exec "$EMACS" ${EMACS_ARGS[@]+"${EMACS_ARGS[@]}"}
  else
    exec "$EMACS" -nw ${EMACS_ARGS[@]+"${EMACS_ARGS[@]}"}
  fi
fi

# An existing instance is always reused in the current terminal.
exec "$EMACSCLIENT" -t ${CLIENT_ARGS[@]+"${CLIENT_ARGS[@]}"}
