onboarding = false
# Herdr configuration
# Install/symlink to ~/.config/herdr/config.toml or set HERDR_CONFIG_PATH to this file.

[keys]
prefix = "ctrl+q"
switch_tab = "prefix+1..9"
switch_workspace = "prefix+shift+1..9"
focus_agent = "prefix+alt+1..9"
new_workspace = ["prefix+shift+n", "super+n"]
previous_workspace = "super+up"
next_workspace = "super+down"
new_tab = ["prefix+c", "super+t"]
next_tab = ["prefix+n", "ctrl+tab"]
previous_tab = ["prefix+p", "ctrl+shift+tab"]

[theme]
name = "solarized"
auto_switch = false

# Herdr's Solarized surface_dim equals its #002b36 panel background, so
# sidebar separators disappear. Use Solarized base02 for subtle chrome.
[theme.custom]
surface_dim = "#073642"

[ui]
agent_panel_sort = "priority"
# ANSI "blue" is too low-contrast for selected tabs in kitty's default palette.
# Use a lighter blue so tab labels (e.g. "1") stay readable.
accent = "#89b4fa"
pane_borders = true
pane_gaps = false
hide_tab_bar_when_single_tab = true
sidebar_width = 7
sidebar_min_width = 0
sidebar_max_width = 50
prompt_new_tab_name = false

[update]
version_check = false

manifest_check = false

[[keys.command]]
key = "prefix+alt+g"
type = "pane"
command = "emacsclient -t -a \"\" --eval \"(progn (require 'magit) (magit-status \\\"$(pwd)\\\"))\""
description = "launch Magit"

# [[keys.command]]
# key = "prefix+m"
# type = "pane"
# command = "exec emacs -nw"
# description = "Emacs"

[[keys.command]]
key = "prefix+m"
type = "shell"
command = '''
created=$("$HERDR_BIN_PATH" tab create --workspace "$HERDR_ACTIVE_WORKSPACE_ID" --label Emacs --focus)
pane=$(printf '%s\n' "$created" | jq -r '.result.root_pane.pane_id')
"$HERDR_BIN_PATH" pane run "$pane" "exec emacs -nw"
'''
description = "Emacs in new tab"

[[keys.command]]
key = "prefix+shift+m"
type = "pane"
command = "exec emacsclient -t"
description = "Emacs client"


