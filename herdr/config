# Herdr configuration
# Install/symlink to ~/.config/herdr/config.toml or set HERDR_CONFIG_PATH to this file.

[keys]
prefix = "ctrl+q"
switch_tab = "prefix+1..9"
switch_workspace = "prefix+shift+1..9"
focus_agent = "prefix+alt+1..9"

[theme]
name = "terminal"

[ui]
agent_panel_sort = "priority"
accent = "blue"
pane_borders = true
pane_gaps = false
hide_tab_bar_when_single_tab = true
sidebar_width = 7
sidebar_min_width = 4
sidebar_max_width = 16
prompt_new_tab_name = false

[update]
version_check = false

manifest_check = false

[[keys.command]]
key = "prefix+alt+g"
type = "pane"
command = "emacsclient -t -a \"\" --eval \"(progn (require 'magit) (magit-status \\\"$(pwd)\\\"))\""
description = "launch Magit"

