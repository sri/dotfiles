onboarding = false
# Herdr configuration
# Install/symlink to ~/.config/herdr/config.toml or set HERDR_CONFIG_PATH to this file.

[keys]
prefix = "ctrl+q"
switch_tab = "prefix+1..9"
switch_workspace = "prefix+shift+1..9"
focus_agent = "prefix+alt+1..9"
new_workspace = ["prefix+shift+n", "super+n"]
previous_workspace = "super+up"
next_workspace = "super+down"
new_tab = ["prefix+c", "super+t"]
next_tab = ["prefix+n", "ctrl+tab"]
previous_tab = ["prefix+p", "ctrl+shift+tab"]
split_horizontal = "prefix+minus"
split_vertical = "prefix+v"
zoom = ["prefix+z", "super+z", "super+1"]
cycle_pane_next = ["prefix+tab", "super+j"]
cycle_pane_previous = ["prefix+shift+tab", "super+shift+j"]
toggle_sidebar = ["prefix+b", "super+b"]

[theme]
name = "gruvbox-light"
auto_switch = false

[ui]
agent_panel_sort = "priority"
pane_borders = true
pane_gaps = false
hide_tab_bar_when_single_tab = true
sidebar_width = 7
sidebar_min_width = 0
sidebar_max_width = 50
prompt_new_tab_name = false

show_agent_labels_on_pane_borders = false
[update]
version_check = false

manifest_check = false

[[keys.command]]
key = "super+s"
type = "popup"
command = "exec \"${SHELL:-sh}\" -l"
description = "command popup"
width = "80%"
height = "50%"

[[keys.command]]
key = "super+r"
type = "shell"
command = '''
"$HERDR_BIN_PATH" server reload-config
"${SHELL:-/bin/sh}" -lc ',terminal_reload'
'''
description = "reload Herdr and terminal config"

[[keys.command]]
key = "prefix+alt+g"
type = "popup"
command = "lazygit"
description = "Lazygit"
width = "90%"
height = "90%"

# [[keys.command]]
# key = "prefix+m"
# type = "pane"
# command = "exec emacs -nw"
# description = "Emacs"

[[keys.command]]
key = "prefix+m"
type = "shell"
command = '''
created=$("$HERDR_BIN_PATH" tab create --workspace "$HERDR_ACTIVE_WORKSPACE_ID" --label Emacs --focus)
pane=$(printf '%s\n' "$created" | jq -r '.result.root_pane.pane_id')
"$HERDR_BIN_PATH" pane run "$pane" "exec emacs -nw"
'''
description = "Emacs in new tab"

[[keys.command]]
key = "prefix+shift+m"
type = "pane"
command = "exec emacsclient -t"
description = "Emacs client"


# Local Variables:
