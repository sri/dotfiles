# -*- mode: sh -*-

# Keep repeated reloads from adding duplicate PATH and completion entries.
typeset -U path PATH fpath FPATH

path=(
  ~/my/dotfiles/bin
  ~/.local/bin
  ~/.cargo/bin
  ~/.bun/bin
  /opt/homebrew/opt/libpq/bin
  ~/.sdkman/candidates/kotlin/current/bin
  ~/.sdkman/candidates/java/current/bin
  "$path[@]"
)

# asdf is active: Node and Python currently resolve through it.
if [[ -r $HOME/.asdf/asdf.sh ]]; then
  . "$HOME/.asdf/asdf.sh"
  fpath=($ASDF_DIR/completions $fpath)
fi

# Bun completion is autoloaded by compinit instead of sourced on every startup.
[[ -r $HOME/.bun/_bun ]] && fpath=($HOME/.bun $fpath)

if [[ -x $HOME/.rbenv/bin/rbenv ]]; then
  # Rehash only after installing executables, not on every shell startup.
  eval "$(~/.rbenv/bin/rbenv init - --no-rehash zsh)"
fi

# Keep SDKMAN available without paying its startup cost in every shell.
export SDKMAN_DIR=$HOME/.sdkman
if [[ -r $SDKMAN_DIR/bin/sdkman-init.sh ]]; then
  function sdk() {
    unfunction sdk
    . "$SDKMAN_DIR/bin/sdkman-init.sh"
    sdk "$@"
  }
fi

# https://unix.stackexchange.com/questions/273861/unlimited-history-in-zsh
HISTFILE="$HOME/.zsh_history"
HISTSIZE=100000
SAVEHIST=100000
setopt BANG_HIST                 # Treat the '!' character specially during expansion.
setopt EXTENDED_HISTORY          # Write the history file in the ":start:elapsed;command" format.
setopt INC_APPEND_HISTORY        # Write to the history file immediately, not when the shell exits.
setopt SHARE_HISTORY             # Share history between all sessions.
setopt HIST_EXPIRE_DUPS_FIRST    # Expire duplicate entries first when trimming history.
setopt HIST_IGNORE_DUPS          # Don't record an entry that was just recorded again.
setopt HIST_IGNORE_ALL_DUPS      # Delete old recorded entry if new entry is a duplicate.
setopt HIST_FIND_NO_DUPS         # Do not display a line previously found.
setopt HIST_IGNORE_SPACE         # Don't record an entry starting with a space.
setopt HIST_SAVE_NO_DUPS         # Don't write duplicate entries in the history file.
setopt HIST_REDUCE_BLANKS        # Remove superfluous blanks before recording entry.
setopt HIST_VERIFY               # Don't execute immediately upon history expansion.
setopt HIST_BEEP                 # Beep when accessing nonexistent history.
setopt INTERACTIVE_COMMENTS      # Allow comments at an interactive prompt.
setopt AUTO_PUSHD                # Make cd push directories onto the directory stack.
setopt PUSHD_IGNORE_DUPS         # Keep duplicate directories out of the stack.
setopt PUSHD_SILENT              # Do not print the stack after every cd.

export PYTHONSTARTUP=~/.pythonrc.py
export RIPGREP_CONFIG_PATH=~/.ripgreprc

# Fast cached completion startup, with a full security/refresh check once a day.
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'
autoload -Uz compinit
_zcompdump=$HOME/.zcompdump
if [[ ! -e $_zcompdump || -n ${_zcompdump}(N.mh+24) ]]; then
  compinit -d $_zcompdump
else
  compinit -C -d $_zcompdump
fi
unset _zcompdump

# Fuzzy history search (Ctrl-R), file insertion (Ctrl-T), and directory cd (Alt-C).
if (( $+commands[fzf] )) && [[ -o interactive && -t 0 ]]; then
  _fzf_shell=/opt/homebrew/opt/fzf/shell
  [[ -r $_fzf_shell/completion.zsh ]] && . $_fzf_shell/completion.zsh
  [[ -r $_fzf_shell/key-bindings.zsh ]] && . $_fzf_shell/key-bindings.zsh
  unset _fzf_shell
fi

# Load Git prompt functions
# --- git branch ---
autoload -Uz vcs_info
zstyle ':vcs_info:git:*' formats '(%b)'
zstyle ':vcs_info:*' enable git

# --- track command start time ---
cmd_start_time=$SECONDS
preexec() {
  cmd_start_time=$SECONDS
}

# --- prompt ---
custom_prompt() {
  local last_exit_status=$1

  local cmd_duration=$((SECONDS - cmd_start_time))
  vcs_info

  # detect emacs / dumb terminal
  local in_emacs=0
  if [[ -n "$INSIDE_EMACS" || "$TERM" == "dumb" ]]; then
    in_emacs=1
  fi

  local prompt_status time_str dir_str branch_str duration_str arrow

  if [[ $in_emacs -eq 1 ]]; then
    # plain ascii, no colors
    time_str='%D{%H:%M:%S}'
    dir_str="[${PWD/#$HOME/~}]"
    branch_str="${vcs_info_msg_0_}"

    if [[ $last_exit_status -eq 0 ]]; then
      prompt_status="OK"
    else
      prompt_status="ERR($last_exit_status)"
    fi

    duration_str="{${cmd_duration}s:${prompt_status}}"
    arrow="> "

    PROMPT="${time_str} ${dir_str} ${branch_str} ${duration_str}"$'\n'"${arrow}"
  else
    # fancy version
    local status_symbol
    if [[ $last_exit_status -eq 0 ]]; then
      status_symbol="%F{green}✔%f"
    else
      status_symbol="%F{red}✘%f"
    fi

    PROMPT="%F{cyan}%D{%H:%M:%S}%f %F{magenta}[%~]%f ${vcs_info_msg_0_} {${cmd_duration}s:${status_symbol}}"$'\n'"→ "
  fi
}

precmd() {
  local last_exit_status=$?
  custom_prompt $last_exit_status
}


# Aliases
alias sub="/Applications/Sublime\ Text.app/Contents/SharedSupport/bin/subl"
